import React, { useState, useEffect } from 'react';
import { X, Save, MapPin, AlertTriangle, Edit2, Upload, Plus, RefreshCw, Database, Zap, GitBranch, Trash2, CheckCircle2 } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import api from '../api';

const SubstationForm = ({ substation, onSave, onCancel, onSLDUpload }) => {
    const [formData, setFormData] = useState(substation || {
        mnemonic: '',
        name: '',
        ownership: 'TNB',
        voltage: '',
        grid: '',
        latitude: '',
        longitude: ''
    });
    const [activeTab, setActiveTab] = useState('metadata');
    const [loadTransformers, setLoadTransformers] = useState([]);
    const [autoTransformers, setAutoTransformers] = useState([]);
    const [incomingBranches, setIncomingBranches] = useState([]);
    const [substationOptions, setSubstationOptions] = useState([]);
    const [assetLoading, setAssetLoading] = useState(false);
    const [assetStatus, setAssetStatus] = useState(null);

    // Modal Control State
    const [editingAsset, setEditingAsset] = useState(null); // { type: 'load'|'auto'|'branch', data: item|null }

    // Form States for Modal
    const [assetForm, setAssetForm] = useState({});

    const GRIDS = ['KEDP', 'PPNG', 'PERK', 'SELG', 'KLUM', 'NSEM', 'MLKA', 'JOH2', 'JOH1', 'PHNG', 'TERG', 'KELN'];
    const VOLTAGES = [500, 275, 132];
    const LOAD_LV = [33, 22, 11];
    const AUTO_LV = [275, 132];

    const handleChange = (e) => {
        const value = e.target.name === 'voltage' ? parseInt(e.target.value) : e.target.value;
        setFormData({ ...formData, [e.target.name]: value });
    };

    const canManageAssets = Boolean(substation?.substation_id);

    const fetchAssets = async () => {
        if (!substation?.substation_id) return;
        setAssetLoading(true);
        try {
            const [loadsRes, autosRes, branchesRes] = await Promise.all([
                api.get(`/load-transformers/?substation=${substation.substation_id}`),
                api.get(`/auto-transformers/?substation=${substation.substation_id}`),
                api.get(`/incoming-branches/?substation=${substation.substation_id}`),
            ]);
            setLoadTransformers(loadsRes.data || []);
            setAutoTransformers(autosRes.data || []);
            setIncomingBranches(branchesRes.data || []);
        } catch (err) {
            setAssetStatus({ type: 'error', msg: 'Failed to load bay assets.' });
        }
        setAssetLoading(false);
    };

    const fetchSubstations = async () => {
        try {
            const res = await api.get('/substations/');
            setSubstationOptions(res.data || []);
        } catch (err) {
            setAssetStatus({ type: 'error', msg: 'Failed to load substations list.' });
        }
    };

    useEffect(() => {
        if (canManageAssets) {
            fetchAssets();
            fetchSubstations();
        }
    }, [canManageAssets, substation?.substation_id]);

    const resetAssetForm = () => {
        setEditingAsset(null);
        setAssetForm({});
    };

    const handleAssetSave = async (type) => {
        if (!substation?.substation_id) return;
        setAssetLoading(true);
        try {
            const endpointMap = {
                load: 'load-transformers',
                auto: 'auto-transformers',
                branch: 'incoming-branches'
            };
            const endpoint = endpointMap[type];
            const payload = { ...assetForm, substation: substation.substation_id };

            if (editingAsset?.data?.id) {
                await api.patch(`/${endpoint}/${editingAsset.data.id}/`, payload);
            } else {
                await api.post(`/${endpoint}/`, payload);
            }

            resetAssetForm();
            await fetchAssets();
            setAssetStatus({ type: 'success', msg: 'Asset saved successfully.' });
        } catch (err) {
            let msg = 'Failed to save asset.';
            if (err.response?.data) {
                msg = Object.entries(err.response.data)
                    .map(([key, val]) => `${key}: ${Array.isArray(val) ? val.join(', ') : val}`)
                    .join(' | ');
            }
            setAssetStatus({ type: 'error', msg });
        }
        setAssetLoading(false);
    };

    const handleAssetDelete = async (type, id) => {
        if (!window.confirm('Are you sure you want to delete this asset?')) return;
        setAssetLoading(true);
        try {
            const endpointMap = {
                load: 'load-transformers',
                auto: 'auto-transformers',
                branch: 'incoming-branches'
            };
            await api.delete(`/${endpointMap[type]}/${id}/`);
            await fetchAssets();
            setAssetStatus({ type: 'success', msg: 'Asset deleted.' });
        } catch (err) {
            setAssetStatus({ type: 'error', msg: 'Failed to delete asset.' });
        }
        setAssetLoading(false);
    };

    const tabButtonStyle = (tab) => {
        const isActive = activeTab === tab;
        return {
            padding: '0.75rem 1rem',
            borderRadius: '0',
            border: 'none',
            background: isActive ? 'rgba(255, 255, 255, 0.05)' : 'transparent',
            color: isActive ? 'var(--accent-blue)' : 'rgba(255, 255, 255, 0.4)',
            fontWeight: 600,
            cursor: 'pointer',
            display: 'flex',
            alignItems: 'center',
            gap: '12px',
            transition: 'all 0.2s',
            fontSize: '0.8rem',
            borderRight: isActive ? '2px solid var(--accent-blue)' : 'none',
            textAlign: 'left'
        };
    };

    const AssetModal = ({ type, data, onClose, onSave }) => {
        const isBranch = type === 'branch';
        const title = data?.id ? 'RECONFIG' : 'INITIALIZE';
        const typeLabel = type.toUpperCase();

        return (
            <AnimatePresence>
                <div style={{
                    position: 'fixed', top: 0, left: 0, right: 0, bottom: 0,
                    background: 'rgba(5, 7, 10, 0.8)', zIndex: 2000,
                    display: 'flex', justifyContent: 'center', alignItems: 'center',
                    backdropFilter: 'blur(4px)'
                }}>
                    <motion.div
                        initial={{ opacity: 0, y: 10 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, y: 10 }}
                        style={{
                            width: '420px', padding: '1.5rem',
                            background: '#15191f',
                            borderRadius: '8px',
                            border: '1px solid rgba(255, 255, 255, 0.1)',
                            boxShadow: '0 40px 80px rgba(0,0,0,0.5)',
                        }}
                    >
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1.5rem' }}>
                            <div>
                                <h3 style={{ margin: 0, fontSize: '0.8rem', fontWeight: 800, color: '#fff', letterSpacing: '1px' }}>{title}_{typeLabel}</h3>
                                <div style={{ fontSize: '0.6rem', color: 'rgba(255,255,255,0.3)', textTransform: 'uppercase', marginTop: '2px' }}>System Asset Integration</div>
                            </div>
                            <button onClick={onClose} style={{ background: 'none', border: 'none', color: 'rgba(255,255,255,0.2)', cursor: 'pointer' }}>
                                <X size={18} />
                            </button>
                        </div>

                        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1rem', marginBottom: '2rem' }}>
                            {isBranch ? (
                                <>
                                    <div style={{ gridColumn: 'span 2' }}>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Target Station</label>
                                        <select className="platinum-input" value={assetForm.to_substation || ''} onChange={(e) => setAssetForm(f => ({ ...f, to_substation: e.target.value }))}>
                                            <option value="">-- SELECT --</option>
                                            {substationOptions.map((s) => (
                                                <option key={s.substation_id} value={s.substation_id}>{s.substation_id} - {s.name}</option>
                                            ))}
                                        </select>
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Circuit ID</label>
                                        <input className="platinum-input mono" value={assetForm.ckt_id || ''} onChange={(e) => setAssetForm(f => ({ ...f, ckt_id: e.target.value }))} placeholder="1" />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Breaker ID</label>
                                        <input className="platinum-input mono" value={assetForm.breaker_number || ''} onChange={(e) => setAssetForm(f => ({ ...f, breaker_number: e.target.value }))} placeholder="B-0" />
                                    </div>
                                </>
                            ) : (
                                <>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Unit Number</label>
                                        <input className="platinum-input mono" type="number" value={assetForm.transformer_no || ''} onChange={(e) => setAssetForm(f => ({ ...f, transformer_no: e.target.value }))} />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>LV Voltage (kV)</label>
                                        <select className="platinum-input mono" value={assetForm.lv_voltage || ''} onChange={(e) => setAssetForm(f => ({ ...f, lv_voltage: e.target.value }))}>
                                            <option value="">--</option>
                                            {(type === 'load' ? LOAD_LV : AUTO_LV).map(v => <option key={v} value={v}>{v} kV</option>)}
                                        </select>
                                    </div>
                                    <div style={{ gridColumn: 'span 2' }}>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Capacity (MVA)</label>
                                        <input className="platinum-input mono" type="number" value={assetForm.capacity_mva || ''} onChange={(e) => setAssetForm(f => ({ ...f, capacity_mva: e.target.value }))} />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>HV Breaker</label>
                                        <input className="platinum-input mono" value={assetForm.hv_breaker_number || ''} onChange={(e) => setAssetForm(f => ({ ...f, hv_breaker_number: e.target.value }))} placeholder="B1" />
                                    </div>
                                </>
                            )}
                        </div>

                        <div style={{ display: 'flex', gap: '0.5rem' }}>
                            <button onClick={onClose} className="btn-secondary" style={{ flex: 1, padding: '0.6rem', borderRadius: '4px', fontSize: '0.7rem' }}>ABORT</button>
                            <button
                                onClick={() => onSave(type)}
                                className="btn-primary"
                                style={{ flex: 2, padding: '0.6rem', borderRadius: '4px', fontSize: '0.7rem' }}
                                disabled={assetLoading}
                            >
                                {assetLoading ? 'SYNCING...' : 'SAVE_CONFIG'}
                            </button>
                        </div>
                    </motion.div>
                </div>
            </AnimatePresence>
        );
    };

    return (
        <>
            <AnimatePresence>
                {editingAsset && (
                    <AssetModal
                        type={editingAsset.type}
                        data={editingAsset.data}
                        onClose={resetAssetForm}
                        onSave={handleAssetSave}
                    />
                )}
            </AnimatePresence>

            <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: 20 }}
                style={{
                    position: 'relative',
                    width: '98%',
                    maxWidth: '1200px',
                    margin: '0 auto',
                    height: 'calc(100vh - 120px)',
                    maxHeight: '800px',
                    display: 'flex',
                    flexDirection: 'column',
                    overflow: 'hidden',
                    background: '#0f1115',
                    borderRadius: '16px',
                    border: '1px solid rgba(255, 255, 255, 0.08)',
                    boxShadow: '0 30px 60px rgba(0, 0, 0, 0.6)'
                }}
            >
                {/* Precision Header */}
                <div style={{
                    padding: '1rem 1.5rem',
                    borderBottom: '1px solid rgba(255, 255, 255, 0.08)',
                    display: 'flex',
                    justifyContent: 'space-between',
                    alignItems: 'center',
                    background: 'rgba(255,255,255,0.02)'
                }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                        <div style={{ padding: '8px', background: 'rgba(0, 229, 255, 0.05)', borderRadius: '8px', border: '1px solid rgba(0, 229, 255, 0.1)' }}>
                            {substation?.substation_id ? <Edit2 size={16} color="var(--accent-blue)" /> : <Plus size={16} color="var(--accent-blue)" />}
                        </div>
                        <div>
                            <h2 style={{ margin: 0, fontSize: '1rem', fontWeight: 700, color: '#fff', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
                                {substation?.substation_id ? substation.name : 'System Initialization'}
                            </h2>
                            {substation?.substation_id && (
                                <span style={{ fontSize: '0.65rem', color: 'rgba(255, 255, 255, 0.3)', fontFamily: 'monospace' }}>
                                    UID: {substation.substation_id}
                                </span>
                            )}
                        </div>
                    </div>
                    <button onClick={onCancel} style={{ background: 'transparent', border: 'none', color: 'rgba(255,255,255,0.4)', cursor: 'pointer', padding: '8px' }}>
                        <X size={20} />
                    </button>
                </div>

                <div style={{ display: 'flex', flex: 1, overflow: 'hidden' }}>
                    {/* Precision Sidebar */}
                    <div style={{
                        width: '200px',
                        background: 'rgba(0,0,0,0.2)',
                        borderRight: '1px solid rgba(255, 255, 255, 0.08)',
                        display: 'flex',
                        flexDirection: 'column'
                    }}>
                        {[
                            { id: 'metadata', label: 'METADATA', icon: MapPin },
                            { id: 'load', label: 'LOAD_TRX', icon: Zap },
                            { id: 'auto', label: 'AUTO_TRX', icon: Database },
                            { id: 'branch', label: 'BRANCHES', icon: GitBranch },
                        ].map(tab => (
                            <button
                                key={tab.id}
                                type="button"
                                onClick={() => setActiveTab(tab.id)}
                                disabled={tab.id !== 'metadata' && !canManageAssets}
                                style={tabButtonStyle(tab.id)}
                            >
                                <tab.icon size={16} />
                                <span style={{ letterSpacing: '0.5px' }}>{tab.label}</span>
                            </button>
                        ))}

                        {!canManageAssets && (
                            <div style={{ marginTop: 'auto', padding: '1.25rem', borderTop: '1px solid rgba(255,255,255,0.05)' }}>
                                <div style={{ fontSize: '0.65rem', color: 'rgba(255, 255, 255, 0.2)', textAlign: 'center', lineHeight: 1.4 }}>
                                    LOCKED: Complete metadata to access assets.
                                </div>
                            </div>
                        )}
                    </div>

                    {/* Content Area */}
                    <div style={{ flex: 1, padding: '1.5rem', overflowY: 'auto' }}>
                        {activeTab === 'metadata' && (
                            <form onSubmit={(e) => {
                                e.preventDefault();
                                const { substation_id, sld, sld_file, transformers, incoming_bays, created_at, updated_at, state, region, ...editableData } = formData;
                                onSave(editableData);
                            }} style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>

                                {/* Precision Grid: 4 Pillars */}
                                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '1rem' }}>
                                    <div style={{ gridColumn: 'span 2' }}>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Full Station Identifier</label>
                                        <input name="name" className="platinum-input" value={formData.name} onChange={handleChange} required />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Mnemonic</label>
                                        <input name="mnemonic" className="platinum-input mono" value={formData.mnemonic} onChange={handleChange} required placeholder="MNEM" />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Nominal kV</label>
                                        <select name="voltage" className="platinum-input" value={formData.voltage} onChange={handleChange} required>
                                            <option value="">--</option>
                                            {VOLTAGES.map(v => <option key={v} value={v}>{v} kV</option>)}
                                        </select>
                                    </div>

                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Grid Unit</label>
                                        <select name="grid" className="platinum-input" value={formData.grid} onChange={handleChange} required>
                                            <option value="">--</option>
                                            {GRIDS.map(g => <option key={g} value={g}>{g}</option>)}
                                        </select>
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Ownership</label>
                                        <select name="ownership" className="platinum-input" value={formData.ownership} onChange={handleChange}>
                                            <option value="TNB">TNB</option>
                                            <option value="DC">DC</option>
                                            <option value="LSS">LSS</option>
                                            <option value="IPP">IPP</option>
                                            <option value="LPC">LPC</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Latitude</label>
                                        <input name="latitude" type="number" step="any" className="platinum-input mono" value={formData.latitude} onChange={handleChange} />
                                    </div>
                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Longitude</label>
                                        <input name="longitude" type="number" step="any" className="platinum-input mono" value={formData.longitude} onChange={handleChange} />
                                    </div>

                                    <div>
                                        <label style={{ display: 'block', fontSize: '0.6rem', color: 'rgba(255,255,255,0.4)', textTransform: 'uppercase', marginBottom: '6px', fontWeight: 700 }}>Commission Date</label>
                                        <input name="commission_date" type="date" className="platinum-input mono" value={formData.commission_date || ''} onChange={handleChange} />
                                    </div>
                                    <div style={{ gridColumn: 'span 3', alignSelf: 'end' }}>
                                        {substation?.substation_id && (
                                            <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>
                                                <input type="file" id="sld-upload-input" hidden accept=".pdf,.dxf,.svg,image/*" onChange={(e) => e.target.files[0] && onSLDUpload?.(substation.substation_id, e.target.files[0])} />
                                                <label htmlFor="sld-upload-input" style={{
                                                    flex: 1, padding: '0.5rem', border: '1px dashed rgba(255,255,255,0.1)', borderRadius: '8px',
                                                    display: 'flex', justifyContent: 'center', alignItems: 'center', gap: '8px', cursor: 'pointer',
                                                    fontSize: '0.7rem', color: 'rgba(255,255,255,0.5)', background: 'rgba(255,255,255,0.01)'
                                                }}>
                                                    <Upload size={14} /> {substation.sld_file ? 'UPDATE_SLD_FILE' : 'INITIALIZE_SLD_FILE'}
                                                </label>
                                                <button type="submit" className="btn-primary" style={{ flex: 1, padding: '0.5rem', fontSize: '0.8rem', borderRadius: '8px', height: '36px' }}>
                                                    <Save size={16} /> COMMIT_SYSTEM_CHANGES
                                                </button>
                                            </div>
                                        )}
                                        {!substation?.substation_id && (
                                            <button type="submit" className="btn-primary" style={{ width: '100%', padding: '0.5rem', fontSize: '0.8rem', borderRadius: '8px', height: '36px' }}>
                                                <Plus size={16} /> INITIALIZE_NEW_STATION
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </form>
                        )}
                        {activeTab !== 'metadata' && (
                            <div style={{ display: 'flex', flexDirection: 'column', height: '100%' }}>
                                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem', paddingBottom: '0.75rem', borderBottom: '1px solid rgba(255,255,255,0.05)' }}>
                                    <h3 style={{ margin: 0, fontSize: '0.7rem', color: 'rgba(255,255,255,0.4)', fontWeight: 800, letterSpacing: '1px' }}>
                                        {activeTab.toUpperCase()}_INVENTORY
                                    </h3>
                                    <div style={{ display: 'flex', gap: '0.5rem' }}>
                                        <button className="btn-secondary" style={{ padding: '4px 8px', fontSize: '0.7rem', borderRadius: '4px' }} onClick={fetchAssets} disabled={assetLoading}>
                                            <RefreshCw size={12} className={assetLoading ? 'animate-spin' : ''} />
                                        </button>
                                        <button className="btn-primary" style={{ padding: '4px 12px', fontSize: '0.7rem', borderRadius: '4px' }} onClick={() => {
                                            setEditingAsset({ type: activeTab, data: null });
                                            setAssetForm({});
                                        }}>
                                            <Plus size={12} /> ADD_ASSET
                                        </button>
                                    </div>
                                </div>

                                <div style={{
                                    display: 'grid',
                                    gridTemplateColumns: 'repeat(auto-fill, minmax(240px, 1fr))',
                                    gap: '0.75rem',
                                    padding: '0.25rem'
                                }}>
                                    {(activeTab === 'load' ? loadTransformers : activeTab === 'auto' ? autoTransformers : incomingBranches).map((asset) => (
                                        <div
                                            key={asset.id}
                                            style={{
                                                background: 'rgba(255, 255, 255, 0.02)',
                                                border: '1px solid rgba(255, 255, 255, 0.08)',
                                                borderRadius: '4px',
                                                padding: '1rem',
                                                display: 'flex',
                                                flexDirection: 'column',
                                                gap: '0.75rem',
                                                position: 'relative'
                                            }}
                                        >
                                            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                                                <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                                                    <div style={{ width: '4px', height: '12px', background: 'var(--accent-blue)' }} />
                                                    <span style={{ fontSize: '0.75rem', color: '#fff', fontFamily: 'monospace', fontWeight: 700 }}>
                                                        {asset.bay_id}
                                                    </span>
                                                </div>
                                                <div style={{ display: 'flex', gap: '4px' }}>
                                                    <button
                                                        onClick={() => { setEditingAsset({ type: activeTab, data: asset }); setAssetForm(asset); }}
                                                        style={{ background: 'transparent', border: 'none', color: 'rgba(255,255,255,0.3)', cursor: 'pointer', padding: '4px' }}
                                                    >
                                                        <Edit2 size={12} />
                                                    </button>
                                                    <button
                                                        onClick={() => handleAssetDelete(activeTab, asset.id)}
                                                        style={{ background: 'transparent', border: 'none', color: 'rgba(239, 68, 68, 0.4)', cursor: 'pointer', padding: '4px' }}
                                                    >
                                                        <Trash2 size={12} />
                                                    </button>
                                                </div>
                                            </div>

                                            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '4px' }}>
                                                {activeTab === 'branch' ? (
                                                    <>
                                                        <div style={{ gridColumn: 'span 2', padding: '6px', background: 'rgba(255,255,255,0.03)', border: '1px solid rgba(255,255,255,0.05)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: 'rgba(255,255,255,0.3)', textTransform: 'uppercase' }}>REMOTE_NODE</div>
                                                            <div style={{ fontSize: '0.8rem', color: '#fff', fontWeight: 600 }}>{asset.to_substation}</div>
                                                        </div>
                                                        <div style={{ padding: '6px', background: 'rgba(255,255,255,0.03)', border: '1px solid rgba(255,255,255,0.05)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: 'rgba(255,255,255,0.3)', textTransform: 'uppercase' }}>CKT</div>
                                                            <div style={{ fontSize: '0.8rem', color: 'var(--accent-blue)', fontWeight: 700 }}>{asset.ckt_id}</div>
                                                        </div>
                                                        <div style={{ padding: '6px', background: 'rgba(255,255,255,0.03)', border: '1px solid rgba(255,255,255,0.05)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: 'rgba(255,255,255,0.3)', textTransform: 'uppercase' }}>BRK</div>
                                                            <div style={{ fontSize: '0.8rem', color: '#fff', fontFamily: 'monospace' }}>{asset.breaker_number || '---'}</div>
                                                        </div>
                                                    </>
                                                ) : (
                                                    <>
                                                        <div style={{ padding: '6px', background: 'rgba(255,255,255,0.03)', border: '1px solid rgba(255,255,255,0.05)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: 'rgba(255,255,255,0.3)', textTransform: 'uppercase' }}>UNIT</div>
                                                            <div style={{ fontSize: '0.8rem', color: '#fff', fontWeight: 700 }}>T{asset.transformer_no}</div>
                                                        </div>
                                                        <div style={{ padding: '6px', background: 'rgba(0, 229, 255, 0.05)', border: '1px solid rgba(0, 229, 255, 0.1)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: 'var(--accent-blue)', textTransform: 'uppercase' }}>LV_kV</div>
                                                            <div style={{ fontSize: '0.8rem', color: 'var(--accent-blue)', fontWeight: 700 }}>{asset.lv_voltage}</div>
                                                        </div>
                                                        <div style={{ gridColumn: 'span 2', padding: '6px', background: 'rgba(255, 159, 67, 0.05)', border: '1px solid rgba(255, 159, 67, 0.1)' }}>
                                                            <div style={{ fontSize: '0.5rem', color: '#ff9f43', textTransform: 'uppercase' }}>CAPACITY_MVA</div>
                                                            <div style={{ fontSize: '0.85rem', color: '#ff9f43', fontWeight: 800 }}>{asset.capacity_mva}</div>
                                                        </div>
                                                    </>
                                                )}
                                            </div>
                                        </div>
                                    ))}
                                    {(activeTab === 'load' ? loadTransformers : activeTab === 'auto' ? autoTransformers : incomingBranches).length === 0 && (
                                        <div style={{ gridColumn: '1 / -1', padding: '2rem 0', textAlign: 'center', opacity: 0.1, border: '1px dashed rgba(255,255,255,0.1)' }}>
                                            <div style={{ fontSize: '0.7rem' }}>DATASET_EMPTY</div>
                                        </div>
                                    )}
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </motion.div>
        </>
    );
};

export default SubstationForm;
